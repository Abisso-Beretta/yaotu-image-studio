{
  "name": "yaotu-ui",
  "private": true,
  "type": "module",
  "description": "妖荼 出图工具的新前端（Vite + React + TS + Tailwind + Zustand）。后端仍是仓库根目录的 server.js。",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "build:mobile": "tsc && vite build --mode mobile",
    "cap:sync": "npm run build:mobile && cap sync android",
    "android:apk": "cd android && gradlew assembleDebug",
    "android:apk:release": "cd android && gradlew assembleRelease"
  },
  "dependencies": {
    "@capacitor-community/media": "^7.0.0",
    "@capacitor/android": "^6.2.1",
    "@capacitor/app": "^6.0.3",
    "@capacitor/camera": "^6.1.3",
    "@capacitor/core": "^6.2.1",
    "@capacitor/filesystem": "^6.0.4",
    "capacitor-secure-storage-plugin": "^0.10.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.1",
    "@types/node": "^20.14.10",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.39",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.5.3",
    "vite": "^5.3.3"
  }
}
